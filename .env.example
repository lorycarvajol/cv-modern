# Copier en `.env` sur le VPS et renseigner. Le fichier .env n'est pas versionne.
#
# Cle API Resend (https://resend.com/api-keys). Elle autorise l'envoi d'e-mails
# au nom du domaine : elle reste sur le serveur, jamais dans le code du site.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Expediteur. Le domaine doit etre verifie dans Resend (enregistrements SPF et
# DKIM a ajouter chez OVH, en meme temps que les A records du deploiement).
MAIL_FROM=contact@lorycarvajol.dev

# Destinataire : la boite qui recoit les messages du formulaire.
MAIL_TO=lorycarvajolwebdev@gmail.com
