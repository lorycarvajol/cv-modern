{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run build:*)",
      "Bash(npm run sass:*)",
      "Bash(npm run:*)",
      "mcp__ide__getDiagnostics",
      "Bash(timeout 15 npm start)",
      "Bash(rm:*)",
      "Bash(npm uninstall:*)",
      "Bash(npm cache clean:*)",
      "Bash(npm install)",
      "Bash(npm start)",
      "Bash(grep:*)",
      "Bash(tasklist:*)",
      "Bash(npx kill-port:*)",
      "Bash(npm install:*)",
      "Bash(BROWSER=none CI=true timeout 60 npm start)",
      "Bash(tee /tmp/cra-dev2.log)",
      "Bash(cygpath -w /tmp/cra-dev2.log)",
      "Bash(BROWSER=none timeout 40 node ./node_modules/react-scripts/bin/react-scripts.js start)",
      "Bash(tee /tmp/cra-dev3.log)",
      "Bash(xxd /tmp/cra-dev3.log)",
      "PowerShell(Get-Process *)",
      "Bash(node -e \"require\\('eslint-plugin-jsx-a11y'\\)\")",
      "PowerShell(attrib *)",
      "Bash(npx eslint *)",
      "Read(//c/Program Files \\(x86\\)/Microsoft/Edge/Application/**)",
      "Read(//c/Program Files/Google/Chrome/Application/**)"
    ],
    "deny": []
  }
}
